x = a<b===c>d
  => x = a < b === c > d
x = a <= b !== c >= d
  => x = a <= b !== c >= d
x = a instanceof B
  => x = a instanceof B
x = (a === b) === c
  => x = a === b === c
x = a&&b||c
  => x = a && b || c
x = (a || b) && c
  => x = (a || b) && c
x = a ?? b
  => x = a ?? b
x = (a ?? b) || c
  => x = (a ?? b) || c
x = a || (b ?? c)
  => x = a || (b ?? c)
x = (a ?? b) ?? c
  => x = a ?? b ?? c
x = !a && !!b
  => x = !a && !!b
x = !(a && b)
  => x = !(a && b)
