x = ( a ) => a
  => x = (a) => a
x = async ( a , b = 1 , ... c ) => a
  => x = async (a, b = 1, ...c) => a
x = ( ) => ( { a } )
  => x = () => ({ a })
x = ( ) => ( a + b )
  => x = () => a + b
x = ( ) => { return 1 }
  => x = () => { return 1 }
[ a , b = 1 , ... c ] = d
  => [a, b = 1, ...c] = d
( { a , b : c , ... d } = e )
  => ({ a, b: c, ...d } = e)
x = ( a ) => ( b ) => c
  => x = (a) => (b) => c
