a=b=c
  => a = b = c
a+=1
  => a += 1
a -= b *= c
  => a -= b *= c
a **= 2
  => a **= 2
a ??= b
  => a ??= b
a.b[c] = d
  => a.b[c] = d
(a) = 1
  => a = 1
x = a?b:c
  => x = a ? b : c
x = a ? b : c ? d : e
  => x = a ? b : c ? d : e
x = (a ? b : c) ? d : e
  => x = (a ? b : c) ? d : e
x = a ? (b, c) : d
  => x = a ? (b, c) : d
x = a ? b = 1 : c
  => x = a ? b = 1 : c
